<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- MissingApplicationIcon: el ícono de la app está fuera del alcance de v0.1 del design
         system (GUIDELINES, supuestos). Se quita el ignore cuando exista. -->
    <application
        android:name=".CanchitasApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        tools:ignore="MissingApplicationIcon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links del link de invitación (RF-011): https://<dominio>/i/<token>. El dominio
                 sale de la propiedad canchitas.dominioDeLinks y la verificación, del
                 /.well-known/assetlinks.json que sirve la web de ese dominio. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${dominioDeLinks}" />
                <data android:pathPrefix="/i/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
