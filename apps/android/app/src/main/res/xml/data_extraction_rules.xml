<?xml version="1.0" encoding="utf-8"?>
<!-- Sin copias en la nube ni transferencia entre dispositivos: la sesión y los datos cifrados
     con claves del dispositivo no sirven en otro (ADR 0009). La app vuelve a bajar todo de la API. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
