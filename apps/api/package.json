{
  "name": "@canchitas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=dev.env --watch src/main-api.ts | pino-pretty",
    "dev:worker": "node --env-file=dev.env --env-file=dev.worker.env --watch src/main-worker.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "generate": "node src/generar-contrato.ts",
    "db:types": "kysely-codegen --dialect postgres --url postgres://canchitas_readonly:canchitas_readonly@localhost:5433/canchitas --out-file src/shared/db/tipos.generated.ts --exclude-pattern '{schema_migrations,spatial_ref_sys,geography_columns,geometry_columns}'",
    "lint": "eslint . && depcruise src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "db:types:check": "kysely-codegen --dialect postgres --url postgres://canchitas_readonly:canchitas_readonly@localhost:5433/canchitas --out-file src/shared/db/tipos.generated.ts --exclude-pattern '{schema_migrations,spatial_ref_sys,geography_columns,geometry_columns}' --verify"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.0",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "kysely": "0.29.6",
    "neverthrow": "8.2.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@canchitas/eslint-config": "workspace:*",
    "@canchitas/tsconfig": "workspace:*",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.2",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "kysely-codegen": "0.20.0",
    "pino-pretty": "13.1.3",
    "postgres-interval": "1.2.0",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
