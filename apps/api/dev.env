# Solo dev local, contra el Postgres de infra/compose. No hay secretos: en staging y prod
# las variables salen de SOPS (ADR 0013). En dev la contraseña de cada rol es su nombre.
DATABASE_URL=postgres://canchitas_api:canchitas_api@localhost:5433/canchitas
PORT=3001
LOG_LEVEL=info
# Auth (ADR 0009). Solo dev: en staging y prod el secreto sale de SOPS.
AUTH_SECRETO=secreto-de-desarrollo-no-usar-en-produccion
URL_API=http://localhost:8080
URL_WEB=http://localhost:8080
# Mailpit de infra/compose (ADR 0019): los mails se ven en http://localhost:8025.
SMTP_HOST=localhost
SMTP_PUERTO=1025
