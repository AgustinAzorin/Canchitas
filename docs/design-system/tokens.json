      "card-foreground": "{neutral.50}",
      "popover": "{neutral.900}",
      "popover-foreground": "{neutral.50}",
      "muted": "{neutral.800}",
      "muted-foreground": "{neutral.300}",
      "border": "{neutral.800}",
      "input": "{neutral.500}",
      "ring": "{brand.400}",
      "primary": "{brand.400}",
      "primary-foreground": "{brand.950}",
      "primary-container": "{brand.900}",
      "primary-container-foreground": "{brand.100}",
      "secondary": "{neutral.800}",
      "secondary-foreground": "{neutral.50}",
      "accent": "{brand.950}",
