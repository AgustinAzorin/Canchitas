      "surface": "#FFFFFF",
      "surface-foreground": "{neutral.950}",
      "card": "#FFFFFF",
      "card-foreground": "{neutral.950}",
      "popover": "#FFFFFF",
      "popover-foreground": "{neutral.950}",
      "muted": "{neutral.100}",
      "muted-foreground": "{neutral.700}",
      "border": "{neutral.300}",
      "input": "{neutral.500}",
      "ring": "{brand.500}",
      "primary": "{brand.600}",
      "primary-foreground": "#FFFFFF",
      "primary-container": "{brand.100}",
      "primary-container-foreground": "{brand.800}",
      "secondary": "{neutral.200}",
      "secondary-foreground": "{neutral.900}",
      "accent": "{brand.50}",
      "accent-foreground": "{brand.800}",
      "destructive": "{red.600}",
      "destructive-foreground": "#FFFFFF",
      "success": "{green.700}",
