  "typography": {
    "fonts": {
      "sans": {
        "family": "Barlow",
        "fallback": "ui-sans-serif, system-ui, sans-serif",
        "variable": false,
        "weights": [
          400,
          500,
          600,
          700
        ]
      },
      "display": {
        "family": "Barlow Condensed",
        "fallback": "'Arial Narrow', ui-sans-serif, system-ui, sans-serif",
        "variable": false,
        "weights": [
          700
        ]
      }
    },
    "scale": {
      "display": {
        "font": "display",
        "size": 40,
        "lineHeight": 44,
        "weight": 700,
        "tracking": -0.01
      },
      "h1": {
        "font": "sans",
        "size": 28,
        "lineHeight": 36,
        "weight": 700,
        "tracking": -0.01
      },
      "h2": {
        "font": "sans",
        "size": 24,
        "lineHeight": 32,
        "weight": 600,
        "tracking": -0.01
      },
      "h3": {
        "font": "sans",
        "size": 20,
        "lineHeight": 28,
        "weight": 600
      },
      "h4": {
        "font": "sans",
        "size": 18,
        "lineHeight": 24,
        "weight": 600
      },
      "body-lg": {
        "font": "sans",
        "size": 18,
        "lineHeight": 28,
        "weight": 400
      },
      "body": {
        "font": "sans",
        "size": 16,
        "lineHeight": 24,
        "weight": 400
      },
      "body-sm": {
        "font": "sans",
        "size": 14,
        "lineHeight": 20,
        "weight": 400
      },
      "label": {
        "font": "sans",
        "size": 14,
        "lineHeight": 20,
        "weight": 500,
        "tracking": 0.01
      },
      "caption": {
        "font": "sans",
        "size": 12,
        "lineHeight": 16,
        "weight": 500,
        "tracking": 0.02
      }
    }
  },
  "spacing": {
    "base": 4,
    "scale": {
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24,
      "2xl": 32,
      "3xl": 48
    }
  },
  "radius": {
    "sm": 4,
    "md": 6,
    "lg": 10,
    "xl": 14,
    "full": 9999
  },
  "elevation": {
    "sm": {
      "shadow": "0 1px 2px rgb(29 30 33 / 0.08)",
      "dp": 1
    },
    "md": {
      "shadow": "0 4px 12px rgb(29 30 33 / 0.10)",
      "dp": 3
    },
    "lg": {
      "shadow": "0 12px 32px rgb(29 30 33 / 0.16)",
      "dp": 6
    }
  },
  "motion": {
    "duration": {
      "fast": 120,
      "normal": 200,
      "slow": 300
    },
    "easing": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "emphasized": [
        0.3,
        0,
        0,
        1
      ]
    }
  },
  "contrastPairs": [
    [
      "primary",
      "surface",
      3
    ],
    [
      "primary",
      "background",
      3
    ],
    [
      "input",
      "surface",
      3
    ],
    [
      "input",
      "background",
      3
    ],
    [
      "team-light",
      "team-dark",
      3
    ],
    [
      "destructive",
      "surface",
      3
    ],
    [
      "success",
      "surface",
      3
    ],
    [
      "ring",
      "surface",
      3
    ],
    [
      "team-dark-border",
      "surface",
      3
    ],
    [
      "team-dark-border",
      "background",
      3
    ]
  ]
}
